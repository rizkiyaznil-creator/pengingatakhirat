# Salin file ini menjadi `.env` untuk pengembangan lokal, lalu isi nilainya.
# Nilai diambil dari dashboard Supabase: Project Settings → API.
# Anon/public key AMAN dipakai di frontend (dilindungi Row Level Security).

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opsional: kunci VAPID publik untuk Web Push adzan (sudah ada default di kode).
# VITE_VAPID_PUBLIC_KEY=BMEg2gD...
